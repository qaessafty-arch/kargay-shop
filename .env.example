# Copy to .env (never commit .env). Values shown are defaults.
NODE_ENV=production
PORT=3000
# Folder for the SQLite database and uploaded photos. Back this folder up.
DATA_DIR=./data
# Required behind HTTPS in production (cookies are Secure only when NODE_ENV=production).
COOKIE_SECURE=true
# Set to 1 when a single reverse proxy (nginx, Caddy, a hosting platform) sits in front of the app.
TRUST_PROXY=1
